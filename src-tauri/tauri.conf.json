{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YakuCraft",
  "version": "1.0.0",
  "identifier": "dev.yakucraft.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YakuCraft",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost;",
      "devCsp": "default-src 'self' http://localhost:1421; img-src 'self' asset: http://asset.localhost blob: http://localhost:1421; style-src 'self' 'unsafe-inline' http://localhost:1421; script-src 'self' http://localhost:1421; font-src 'self' http://localhost:1421; connect-src ipc: http://ipc.localhost http://localhost:1421 ws://localhost:1421;"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "publisher": "YakuCraft",
    "copyright": "Copyright (c) 2026 YakuCraft",
    "shortDescription": "Minecraft Mod 翻訳アプリ",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "ja-JP"
      },
      "nsis": {
        "languages": ["Japanese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3MzkzOTk5Rjc4MjBDQTYKUldTbURJTDNtVGs1cDF6WHAyeGNzOWEvWFl5TjNFTVB0M1BHb0VCdDlMclU5aUQrKzJOTXllUloK",
      "endpoints": [
        "https://github.com/yoima-jp/YakuCraft/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
